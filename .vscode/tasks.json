{
    "version": "2.0.0",
    "tasks": [
        {
            // F5 走这个：类型检查 + 打包，跑完再启动扩展宿主。
            // 用内置的 $tsc matcher 映射类型错误 —— 它匹配的是 tsc 的输出格式。
            "label": "build",
            "type": "npm",
            "script": "compile",
            "problemMatcher": "$tsc",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // 常驻监听，保存即重新打包（宿主 + 三个游戏 webview 双 watcher）。
            // 手动启动（终端 → 运行任务 → watch），不在 F5 的路径上：
            // 它是后台常驻任务，而 esbuild 的报错格式（消息行与位置行之间
            // 夹空行）没法可靠映射到「问题」面板，详见 README「已知约束」。
            //
            // 重建后需要在扩展宿主窗口里按 Cmd+R 重载，并重新打开面板才生效。
            "label": "watch",
            "type": "npm",
            "script": "watch",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            // 跑一遍全部单元测试（vitest）。
            "label": "test",
            "type": "npm",
            "script": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}

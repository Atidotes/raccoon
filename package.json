{
  "name": "raccoon",
  "displayName": "Raccoon",
  "description": "一只住在 VS Code 里的浣熊，喜欢翻代码垃圾桶，把游戏、办公和小工具都叼回来给你。",
  "version": "0.1.0",
  "publisher": "Atidotes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atidotes/raccoon.git"
  },
  "icon": "resources/raccoon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "raccoon",
    "浣熊",
    "games",
    "游戏",
    "productivity",
    "办公",
    "tools",
    "小工具",
    "摸鱼"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "raccoon.exportPdf",
        "title": "导出为 PDF",
        "category": "Raccoon"
      },
      {
        "command": "raccoon.refreshBalance",
        "title": "刷新 DeepSeek 余额",
        "category": "Raccoon"
      },
      {
        "command": "raccoon.startTetris",
        "title": "俄罗斯方块",
        "category": "Raccoon"
      },
      {
        "command": "raccoon.startGomoku",
        "title": "五子棋",
        "category": "Raccoon"
      },
      {
        "command": "raccoon.startSnake",
        "title": "贪吃蛇",
        "category": "Raccoon"
      },
      {
        "command": "raccoon.ssh",
        "title": "SSH 连接",
        "category": "Raccoon"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "raccoon",
          "title": "Raccoon",
          "icon": "resources/raccoon.svg"
        }
      ]
    },
    "views": {
      "raccoon": [
        {
          "id": "raccoon.mainView",
          "name": "Raccoon",
          "icon": "resources/raccoon.svg",
          "contextualTitle": "Raccoon"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "raccoon.exportPdf",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "raccoon.exportPdf",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Raccoon",
      "properties": {
        "raccoon.pdf.outputPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "导出 PDF 的输出位置。留空则在 Markdown 文件同目录生成同名 PDF。填目录则在该目录下生成同名 PDF；也可以直接写完整的 `.pdf` 路径。相对路径基于工作区根目录解析。"
        },
        "raccoon.pdf.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Chrome / Chromium / Edge 可执行文件的路径。留空则自动探测（常见安装目录、`PATH`、`CHROME_BIN` 环境变量）。"
        },
        "raccoon.deepseek.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "DeepSeek API Key，用于在状态栏显示账户余额。在 <https://platform.deepseek.com/api_keys> 创建。\n\n**注意：这里是明文存储。** 别提交进 git，也留意截图和录屏。"
        },
        "raccoon.deepseek.refreshIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "markdownDescription": "自动刷新余额的间隔（分钟）。点击状态栏可随时手动刷新。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check-types && npm run clean && npm run build:host && npm run build:webviews",
    "check-types": "tsc -p ./ --noEmit && vue-tsc -p tsconfig.webviews.json && tsc -p tsconfig.tests.json --noEmit",
    "build:host": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:ssh2 --format=cjs --platform=node --target=node18 --sourcemap",
    "build:webviews": "vite build",
    "watch": "concurrently -n host,web -c auto \"npm:watch:host\" \"npm:watch:webviews\"",
    "watch:host": "npm run build:host -- --watch",
    "watch:webviews": "vite build --watch",
    "watch:types": "tsc -p ./ --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run compile && npx @vscode/vsce package",
    "build:vs": "dotnet msbuild src/visualstudio/RaccoonVS.sln -restore -p:Configuration=Release",
    "package:vs": "npm run compile && npm run build:vs"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.75.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "marked-gfm-heading-id": "^4.1.4",
    "ssh2": "^1.17.0"
  }
}

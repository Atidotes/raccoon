<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
                xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!--
      Version 是个自定义占位符，由 csproj 里的 StampVsixVersion 目标在打包前替换成
      $(VsixVersion)（CI 传的是 package.json 的版本补一段）。

      不能写 $(VsixVersion)：MSBuild 只替换「工程文件里」的属性，清单是磁盘上的一个普通
      文件，它不认识 $(...)。而 VSSDK 的 DetokenizeVsixManifestFile 只解析 |工程输出|
      那类 token，也不碰 MSBuild 属性。写属性名的后果是原样打进 vsix，
      装载时报「版本字符串部分太短或太长」——而打包那一步是完全成功的，错误要等安装才炸。
    -->
    <Identity Id="Raccoon.VisualStudio"
              Version="__VSIX_VERSION__"
              Language="zh-CN"
              Publisher="Atidotes" />
    <DisplayName>Raccoon</DisplayName>
    <Description>游戏 / 办公 / 小工具集合：俄罗斯方块、五子棋、贪吃蛇、SSH 连接、Markdown 导出 PDF、DeepSeek 余额。</Description>
    <MoreInfo>https://github.com/Atidotes/raccoon</MoreInfo>
    <License>LICENSE.txt</License>
    <Tags>games, ssh, markdown, pdf, deepseek, tools</Tags>
  </Metadata>

  <Installation>
    <!--
      Community 这个 Id 覆盖全部 SKU（Pro / Enterprise 安装时会按 Community 报兼容）。

      一个架构一个 InstallationTarget 元素（Schema 规定一个元素只放一个架构，同一 Id 可以
      出现多次）。amd64 给 x64 机器，arm64 给 ARM64 机器——arm64 不是凑数声明：包里本来就有
      runtimes\win-arm64\native\WebView2Loader.dll，托管代码是 AnyCPU，.NET Framework 4.8.1
      起原生支持 ARM64，所以是真能跑。

      为什么两个都必须写：ProductArchitecture 在 VS 2022+ 是**必需且无默认值**的，
      而且要参与「适用产品」匹配。开发机是 ARM64 的 VS 2026（18.9，装在
      C:\Program Files\Microsoft Visual Studio\18\Community），清单里只有 amd64 时安装器报：

          VSIXInstaller.NoApplicableSKUsException: 此扩展不能安装在任何当前安装的产品上

      这个报错**一个字都不提架构**，只是在「找到的已安装产品」之后说不匹配，所以第一反应会去
      怀疑版本区间——我先把 [17.0,18.0) 改成 [17.0,) 试了一轮，没用，才回头查架构。
      以后再见到这个报错，先确认架构，别再从版本区间上找。

      版本区间下界 17.0、不写上界：VS 2026 起按 API 版本判兼容、只看下界忽略上界，
      官方给新扩展的模板就是不写上界，以后不用每个大版本回来改一次。
      下界保住 17.0 的理由仍是 WebView2 Runtime：VS 2019 不保证装了，VS 2022 及以后都会带。
    -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>

  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" />
  </Dependencies>

  <Prerequisites>
    <!--
      同样只留下界：这个组件是 VS 核心编辑器，任何 SKU 都必装，写上界除了制造一次
      「VS 2026 装不上」之外没有任何作用（依赖检查同样会被 18.0 的上界挡住）。
    -->
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                 Version="[17.0,)"
                 DisplayName="Visual Studio 核心编辑器" />
  </Prerequisites>

  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage"
           d:Source="Project"
           d:ProjectName="%CurrentProject%"
           Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
